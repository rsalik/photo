# Copy to .env for local development. All values are server-only.
# Leave cloud credentials unset to use local PGlite and image storage.

# Admin access ---------------------------------------------------------------
# Set a password to enable /admin login. An empty value disables login.
ADMIN_PASSWORD=

# Required for production admin sessions. Use a stable, random value.
# Local development generates data/.session-secret when this is omitted.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# Database -------------------------------------------------------------------
# Neon Postgres URL. Required on Cloudflare; optional for local development.
# Without it, the app stores an embedded PGlite database in DATA_DIR/pg.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# R2 image storage -----------------------------------------------------------
# All four values are required for S3-backed reads, writes, and deletions.
# If any is missing, storage falls back to local disk under DATA_DIR.
# R2_BUCKET=photo
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Use a separate private bucket for original source files and their metadata.
# Do not attach a public domain to this bucket.
# R2_ORIGINALS_BUCKET=photo-originals-private

# Public custom domain of the DERIVED image bucket. When set, image routes
# redirect here. Otherwise images are proxied from configured storage.
# R2_PUBLIC_URL=https://cdn.example.com

# Local storage --------------------------------------------------------------
# Parent directory for the app's database, originals, and generated images.
# DATA_DIR=./data

# Deployment and maintenance scripts: see the README.
